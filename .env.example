# Copia este archivo como .env y pega tu URI completo de MongoDB Atlas.
# Cambia <db_password> por la contraseña del usuario de Database Access.
# Si la contraseña tiene símbolos especiales, codifícalos para URL.
MONGO_URI=mongodb+srv://<db_username>:<db_password>@cluster0.vcycack.mongodb.net/jossys_berry?retryWrites=true&w=majority&appName=Cluster0
SESSION_SECRET=replace-with-a-long-random-secret
ADMIN_PASSWORD=replace-with-a-unique-admin-password
GEMINI_API_KEY=replace-with-your-google-ai-studio-api-key
GEMINI_MODEL=gemini-3.8-flash
